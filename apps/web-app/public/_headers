/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Bundles com hash no nome: sempre revalidados (ETag -> 304), nunca `immutable`.
# O fallback SPA de `_redirects` devolve index.html com status 200 para qualquer caminho inexistente;
# se um navegador pedir `main-*.js` durante um deploy, ele guardaria esse HTML pelo prazo do
# Cache-Control e o app ficaria em branco ate limpar o cache. Com `no-cache` a copia ruim e
# revalidada no proximo carregamento e se corrige sozinha.
/main-*.js
  Cache-Control: no-cache

/chunk-*.js
  Cache-Control: no-cache

/polyfills-*.js
  Cache-Control: no-cache

/styles-*.css
  Cache-Control: no-cache

/media/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
