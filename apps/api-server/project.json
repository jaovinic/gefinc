{
  "name": "api-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api-server/src",
  "tags": [
    "scope:api",
    "type:backend"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/pom.xml",
        "{projectRoot}/src/main/**/*"
      ],
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "cwd": "apps/api-server",
        "command": "./mvnw -B -DskipTests package"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api-server",
        "command": "./mvnw -B test"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/api-server",
        "command": "./mvnw -B spring-boot:run -Dspring-boot.run.profiles=local"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/pom.xml",
        "{projectRoot}/src/**/*"
      ],
      "options": {
        "cwd": "apps/api-server",
        "command": "./mvnw -B spotless:check"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api-server",
        "command": "./mvnw -B spotless:apply"
      }
    }
  }
}
