# Copie para .env (não versionado) e ajuste os valores locais.
# Porta do PostgreSQL no host (mude se a 5432 já estiver ocupada na sua máquina).
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/gefinc
DB_USER=gefinc
DB_PASSWORD=gefinc
# Chave de assinatura do JWT: mínimo de 32 caracteres. Gere uma nova em produção.
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-com-32-caracteres-ou-mais
# Chave HMAC dos identificadores pseudonimizados (auditoria, histórico de envios): mínimo de 32 bytes e
# distinta do JWT_SECRET. Em produção gere uma com `openssl rand -base64 48` e guarde junto das demais
# credenciais. NÃO rotacione sem necessidade: identificadores novos deixam de casar com os antigos. Se
# vazar, rotacione e aceite perder a correlação com o histórico (não há perda de dados).
PSEUDONYM_SECRET=troque-esta-chave-de-pseudonimizacao-por-uma-aleatoria-32b
# CIDRs dos proxies confiáveis para ler o IP real do cliente. Vazio em desenvolvimento = nunca confia no
# cabeçalho. No docker-compose.selfhost.yml o padrão é o IP fixo do cloudflared (172.28.0.10/32).
TRUSTED_PROXY_CIDRS=
# Opcionais (padrões: FORWARD_HEADERS_STRATEGY=none e CLIENT_IP_HEADER=CF-Connecting-IP):
# FORWARD_HEADERS_STRATEGY=none
# CLIENT_IP_HEADER=CF-Connecting-IP
# E-mail (redefinição de senha). Padrão de desenvolvimento: Mailpit local, sem login nem TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
# URL pública do front, sem barra final. Em produção é obrigatória (links de e-mail e CORS).
APP_BASE_URL=http://localhost:4200
#
# Produção com Brevo (docker-compose.selfhost.yml). Gere o login SMTP e a chave SMTP no painel
# (SMTP & API > SMTP) e preencha apenas no .env do servidor, nunca neste arquivo versionado:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<login SMTP do Brevo>
# SMTP_PASSWORD=<chave SMTP do Brevo>
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_FROM=nao-responda@seu-dominio-autenticado.exemplo
# APP_BASE_URL=https://app.seu-dominio.exemplo
