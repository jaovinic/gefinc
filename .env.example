# Copie para .env (não versionado) e ajuste os valores locais.
# Porta do PostgreSQL no host (mude se a 5432 já estiver ocupada na sua máquina).
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/gefinc
DB_USER=gefinc
DB_PASSWORD=gefinc
# Chave de assinatura do JWT: mínimo de 32 caracteres. Gere uma nova em produção.
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-com-32-caracteres-ou-mais
SMTP_HOST=localhost
SMTP_PORT=1025
APP_BASE_URL=http://localhost:4200
