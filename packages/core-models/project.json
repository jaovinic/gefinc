{
  "name": "core-models",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core-models/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:lib"
  ],
  "// targets": "to see all targets run: nx show project core-models --web",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/openapi/gefinc.openapi.yaml"
      ],
      "outputs": [
        "{projectRoot}/src/generated/api.ts"
      ],
      "options": {
        "command": "openapi-typescript packages/core-models/openapi/gefinc.openapi.yaml -o packages/core-models/src/generated/api.ts"
      }
    }
  }
}
